<div class="tab scrollable {{tabs.gods.cssClass}}" data-tab="gods" data-group="sheet">
    {{#if selectedGod}}
        <div class="row-section" style="margin-bottom: 10px;">
            <div class="col">
                <button type="button" data-action="closeDetail" class="dsadesignbutton">
                    <i class="fas fa-arrow-left"></i> {{localize "BackToList"}}
                </button>
            </div>
        </div>
        
        <div class="row-section flexAlignCenter table-title" style="margin-bottom: 15px; min-height: 60px;">
            <div class="col zerofive center" style="display: flex; align-items: center; justify-content: center; height: 60px;">
                <img src="{{selectedGod.icon}}" style="width: 40px; height: 40px; object-fit: contain; border: none; background: transparent; display: block; border-radius: 50%; box-shadow: 0 0 3px rgba(0,0,0,0.8);">
            </div>
            <div class="col ninety withContext">
                <span style="padding-left: 10px; font-weight: bold; font-size: 1.2rem;">{{selectedGod.name}}</span>
            </div>
        </div>

        <div class="row-section">
            <div class="col general-rules-wrapper" style="padding: 10px; margin-bottom: 15px; background: rgba(0, 0, 0, 0.05); border: 1px solid rgba(0,0,0,0.2); border-radius: 5px;">
                <p style="margin: 0;">{{{selectedGod.description}}}</p>
            </div>
        </div>
        <div class="row-section flexAlignCenter flexrow" style="justify-content: center; margin-top: 30px; gap: 15px;">
            <div class="center flexcol flexAlignCenter" style="flex: 0 0 50px; height: 50px; justify-content: center;">
                <img src="systems/dsa5/icons/schip.webp" style="width: 45px; height: 45px; object-fit: contain; border: none; background: transparent; display: block; filter: drop-shadow(0 0 2px rgba(0,0,0,0.5));">
            </div>
            
            <div class="center flexcol flexAlignCenter" style="flex: 0 0 auto;">
                <div style="margin-bottom: 5px;">
                    <i class="fa-solid fa-arrow-right-arrow-left" style="font-size: 1.4rem;"></i>
                </div>
                <button type="button" data-action="swapEffect" class="dsadesignbutton">
                    {{localize "Swap"}}
                </button>
            </div>
            
            <div class="center flexcol flexAlignCenter" style="flex: 0 0 50px; height: 50px; justify-content: center;">
                <img src="{{selectedGod.icon}}" style="width: 38px; height: 38px; object-fit: contain; border: none; background: transparent; display: block; border-radius: 50%; box-shadow: 0 0 3px rgba(0,0,0,0.8);">
            </div>
        </div>
    {{else}}
        
        <div class="row-section">
            <div class="col general-rules-wrapper" style="padding: 10px; margin-bottom: 15px; background: rgba(0, 0, 0, 0.05); border: 1px solid rgba(0,0,0,0.2); border-radius: 5px;">
                <h2 style="margin-top: 0;">{{localize "Rules.GodsInitTitle"}}</h2>
                <ul class="dsalist" style="margin-bottom: 0;">
                    <li><p>{{{localize "Rules.GodsInit1"}}}</p></li>
                    <li><p>{{{localize "Rules.GodsInit2"}}}</p></li>
                </ul>
            </div>
        </div>

        <div class="row-section">
            <div class="col">
                <ul class="item-list" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px 10px; margin: 0; padding: 0; list-style: none;">
                    {{#each gods as |god|}}
                    <li class="actor-spell-item item skills lineheight" 
                        style="cursor: pointer; margin: 0; display: flex; align-items: center; padding: 4px;"
                        data-action="openDetail" data-id="{{god.id}}" data-name="{{god.name}}" data-icon="{{god.icon}}" data-type="{{god.type}}" data-description="{{god.description}}">
                        
                        <div class="image" style="flex: 0 0 30px; height: 30px; background-image: url('{{god.icon}}'); background-size: contain; background-repeat: no-repeat; background-position: center;"></div>
                        
                        <div class="actor-spell-name withContext" style="flex: 1 1 auto; padding-left: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            <a>{{god.name}}</a>
                        </div>
                    </li>
                    {{/each}}
                </ul>
            </div>
        </div>
    {{/if}}
</div>
